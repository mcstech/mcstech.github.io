---
import Layout from '../../layouts/Layout.astro';
import previewMain from '../../assets/templates/rockpaper/preview-1.png';
import previewAlt from '../../assets/templates/rockpaper/preview-2.png';

const heroScreenshot = 'https://github.com/user-attachments/assets/0109deed-2aae-4d84-ad30-5e1d82a31aae';

const featureList = [
	'Background video hero with layered call-to-actions',
	'Editorial project templates with goals, approach, and materials',
	'Service index with comparison-ready summaries',
	'Studio story page to highlight team, method, and principles',
	'Embla carousel-ready galleries',
	'Global search with rich previews',
	'Content collections for projects, services, team, and posts',
	'SEO-ready metadata with sensible defaults',
	'Reusable section patterns (hero, stats, timelines, FAQ)',
	'Blog tagging and filtering patterns',
	'Tailwind Forms & Typography presets',
	'Optional PagesCMS wiring for quick content edits',
	'Lightweight motion with CSS transitions only',
	'Lifetime updates and support included'
];

const faqs = [
	{
		question: 'Is Rock Paper compatible with Fresh Deno and Tailwind CSS 4?',
		answer:
			'Yes. The template is authored against Fresh Deno v2.2.0 and Tailwind CSS v4.2, with no client framework dependencies.'
	},
	{
		question: 'Can I extend components without breaking the layout?',
		answer:
			'Blocks are built with semantic HTML, logical spacing tokens, and utility classes. Duplicate sections, swap imagery, and adjust copy without touching brittle CSS.'
	},
	{
		question: 'Do I need JavaScript for the FAQ or layout?',
		answer:
			'No. The FAQ uses plain HTML structure. Motion is limited to CSS transitions and respects reduced-motion preferences.'
	},
	{
		question: 'What files do I receive?',
		answer:
			'You get the Astro source, Tailwind styles, content collection examples, and starter CMS wiring so you can deploy or adapt immediately.'
	}
];
---

<Layout>
	<main class="min-h-screen bg-slate-50 text-slate-900">
		<header class="relative overflow-hidden border-b border-slate-200 bg-white/90 backdrop-blur">
			<div class="absolute inset-0 bg-gradient-to-br from-sky-100 via-white to-emerald-100" aria-hidden="true"></div>
			<div class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 py-14 lg:grid-cols-[1.05fr_0.95fr]">
				<div class="space-y-6">
					<p class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-3 py-1 text-xs text-white tracking-[0.16em]">
						<span class="h-2 w-2 rounded-full bg-emerald-400"></span>
						Rock Paper — Fresh Deno + Tailwind
					</p>
					<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
						Calm, editorial design system for modern interior studios.
					</h1>
					<p class="max-w-2xl text-lg text-slate-600">
						An intentionally minimal template that pairs generous whitespace with confident type. Ship case
						studies, services, and studio principles without touching custom JavaScript.
					</p>
					<div class="flex flex-wrap items-center gap-3">
						<a
							class="rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:shadow-xl"
							href="#whats-included">
							See what's included
						</a>
						<a
							class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 transition hover:-translate-y-0.5 hover:border-slate-400"
							href="/templates">
							Back to templates
						</a>
					</div>
					<div class="grid gap-4 sm:grid-cols-3">
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Stack</p>
							<p class="mt-1 text-base font-semibold text-slate-900">Fresh Deno v2.2.0</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Styles</p>
							<p class="mt-1 text-base font-semibold text-slate-900">Tailwind CSS v4.2</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">License</p>
							<p class="mt-1 text-base font-semibold text-slate-900">Lifetime, one-time</p>
						</div>
					</div>
				</div>
				<figure class="relative">
					<div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/15">
						<img
							src={heroScreenshot}
							loading="lazy"
							decoding="async"
							alt="Rock Paper template page preview"
							class="w-full object-cover" />
					</div>
					<div
						class="absolute -bottom-8 left-6 rounded-2xl border border-white/70 bg-slate-900 px-4 py-3 text-xs text-white shadow-lg shadow-slate-900/20">
						<p class="font-semibold">Screenshot included</p>
						<p class="text-slate-200">Supplied preview embedded directly in this page.</p>
					</div>
				</figure>
			</div>
		</header>

		<section class="mx-auto max-w-6xl px-6 py-12">
			<div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
				<div class="space-y-6">
					<h2 class="text-2xl font-semibold text-slate-900">Purpose-built for thoughtful studios</h2>
					<p class="text-base text-slate-600">
						Rock Paper balances imagery and typography with a steady rhythm. Case studies highlight goals,
						approach, materials, and results. Service pages explain value without fluff, while the studio
						page shares the people, method, and principles that set you apart.
					</p>
					<div class="grid gap-4 sm:grid-cols-2">
						<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
							<h3 class="text-lg font-semibold text-slate-900">Editorial layouts</h3>
							<p class="mt-2 text-sm text-slate-600">
								Story-driven templates with flexible grids, accent captions, and balanced white space.
							</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
							<h3 class="text-lg font-semibold text-slate-900">Production-ready</h3>
							<p class="mt-2 text-sm text-slate-600">
								Semantic HTML, alt-tagged imagery, and WCAG-aware contrast make launch approvals easier.
							</p>
						</div>
					</div>
				</div>
				<div class="rounded-3xl border border-slate-200 bg-white/80 p-5 shadow-lg shadow-slate-900/5">
					<h3 class="text-lg font-semibold text-slate-900">Preview gallery</h3>
					<p class="mt-2 text-sm text-slate-600">
						Focused views of the Rock Paper experience—from immersive hero areas to structured detail
						sections.
					</p>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
							<img src={previewMain.src} alt="Rock Paper homepage preview" class="w-full object-cover" loading="lazy" decoding="async" />
						</div>
						<div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
							<img src={previewAlt.src} alt="Rock Paper interior page preview" class="w-full object-cover" loading="lazy" decoding="async" />
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="whats-included" class="mx-auto max-w-6xl px-6 pb-12">
			<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm sm:px-10 sm:py-12">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">What's included</p>
						<h2 class="mt-2 text-2xl font-semibold text-slate-900">Everything you need to launch</h2>
						<p class="mt-2 max-w-2xl text-base text-slate-600">
							A comprehensive kit that keeps your build focused on storytelling. No extra libraries or
							client frameworks required.
						</p>
					</div>
					<div class="rounded-full bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-700">
						One-time license — lifetime value
					</div>
				</div>
				<ul class="mt-6 grid list-disc gap-3 pl-5 text-sm text-slate-700 md:grid-cols-2">
					{featureList.map((item) => (
						<li class="leading-relaxed">{item}</li>
					))}
				</ul>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 pb-12">
			<div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
				<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm">
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Technology</p>
					<h2 class="mt-2 text-2xl font-semibold text-slate-900">Modern stack, no bloat</h2>
					<p class="mt-2 text-base text-slate-600">
						Rock Paper is built with the latest stable releases of Fresh Deno and Tailwind CSS. Embla is
						available for carousels, but the page experiences are fully functional without additional
						scripts.
					</p>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
							<h3 class="text-lg font-semibold text-slate-900">Performance-first</h3>
							<p class="mt-1 text-sm text-slate-600">Lightweight pages with explicit sizing to avoid layout shift.</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
							<h3 class="text-lg font-semibold text-slate-900">Accessible by design</h3>
							<p class="mt-1 text-sm text-slate-600">Semantic regions, focusable controls, and high-contrast text.</p>
						</div>
					</div>
				</div>
				<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm">
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">FAQ</p>
					<h2 class="mt-2 text-2xl font-semibold text-slate-900">Frequently asked questions</h2>
					<dl class="mt-4 space-y-4 divide-y divide-slate-200">
						{faqs.map((item) => (
							<div class="pt-4 first:pt-0">
								<dt class="text-base font-semibold text-slate-900">{item.question}</dt>
								<dd class="mt-2 text-sm text-slate-600">{item.answer}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 pb-16">
			<div class="rounded-3xl border border-slate-200 bg-gradient-to-r from-slate-900 to-slate-800 px-6 py-10 text-white shadow-xl shadow-slate-900/10 sm:px-10">
				<div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
					<div class="space-y-3">
						<p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-200">Ready to ship</p>
						<h2 class="text-2xl font-semibold">Build a publication-grade studio site without extra JS.</h2>
						<p class="text-sm text-slate-200">
							Copy, paste, and launch. Tailwind utilities keep the design cohesive while letting you
							reshape sections in minutes.
						</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a
							href="/templates"
							class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-lg shadow-white/20 transition hover:-translate-y-0.5">
							Browse templates
						</a>
						<a
							href="#whats-included"
							class="rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/70">
							Review deliverables
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
