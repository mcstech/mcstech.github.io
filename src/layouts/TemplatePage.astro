---
import Layout from './Layout.astro';
import { templatePreviews } from '../data/templatePreviews';

const frontmatter = Astro.props.frontmatter ?? {};

const title = frontmatter.title ?? Astro.props.title ?? 'Template';
const subtitle = frontmatter.subtitle ?? Astro.props.subtitle ?? '';
const heroScreenshot = frontmatter.heroScreenshot ?? Astro.props.heroScreenshot;
const templateKey = frontmatter.templateKey ?? Astro.props.templateKey ?? 'template';
const badge = frontmatter.badge ?? Astro.props.badge ?? 'Template';
const stack = frontmatter.stack ?? Astro.props.stack ?? '';
const styles = frontmatter.styles ?? Astro.props.styles ?? '';
const license = frontmatter.license ?? Astro.props.license ?? '';
const featureList = frontmatter.featureList ?? Astro.props.featureList ?? [];
const faqs = frontmatter.faqs ?? Astro.props.faqs ?? [];
const highlights = frontmatter.highlights ?? Astro.props.highlights ?? [
	'Performance-first layouts',
	'WCAG-aware contrast',
	'No client frameworks'
];
const previewMain = frontmatter.previewMain ?? Astro.props.previewMain ?? '';
const previewSecondary = frontmatter.previewSecondary ?? Astro.props.previewSecondary ?? '';

const resolvedPreviewMain = previewMain || templatePreviews[templateKey]?.main || '';
const resolvedPreviewSecondary = previewSecondary || templatePreviews[templateKey]?.secondary || '';
---

<Layout>
	<main class="min-h-screen bg-slate-50 text-slate-900">
		<header class="relative overflow-hidden border-b border-slate-200 bg-white/90 backdrop-blur">
			<div class="absolute inset-0 bg-gradient-to-br from-sky-100 via-white to-emerald-100" aria-hidden="true"></div>
			<div class="relative mx-auto grid max-w-6xl items-center gap-10 px-6 py-14 lg:grid-cols-[1.05fr_0.95fr]">
				<div class="space-y-6">
					<p class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-3 py-1 text-xs text-white tracking-[0.16em]">
						<span class="h-2 w-2 rounded-full bg-emerald-400"></span>
						{badge}
					</p>
					<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
					<p class="max-w-2xl text-lg text-slate-600">{subtitle}</p>
					<div class="flex flex-wrap items-center gap-3">
						<a
							class="rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:shadow-xl"
							href="#whats-included">
							See what's included
						</a>
						<a
							class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 transition hover:-translate-y-0.5 hover:border-slate-400"
							href="/templates">
							Back to templates
						</a>
					</div>
					<div class="grid gap-4 sm:grid-cols-3">
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Stack</p>
							<p class="mt-1 text-base font-semibold text-slate-900">{stack}</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Styles</p>
							<p class="mt-1 text-base font-semibold text-slate-900">{styles}</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
							<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">License</p>
							<p class="mt-1 text-base font-semibold text-slate-900">{license}</p>
						</div>
					</div>
				</div>
				{heroScreenshot && (
					<figure class="relative">
						<div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/15">
							<img src={heroScreenshot} loading="lazy" decoding="async" alt={`${title} preview`} class="w-full object-cover" />
						</div>
						<div
							class="absolute -bottom-8 left-6 rounded-2xl border border-white/70 bg-slate-900 px-4 py-3 text-xs text-white shadow-lg shadow-slate-900/20">
							<p class="font-semibold">Screenshot included</p>
							<p class="text-slate-200">Supplied preview embedded directly in this page.</p>
						</div>
					</figure>
				)}
			</div>
		</header>

		<section class="mx-auto max-w-6xl px-6 py-12">
			<div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
				<div class="space-y-6">
					<slot />
				</div>
				<div class="rounded-3xl border border-slate-200 bg-white/80 p-5 shadow-lg shadow-slate-900/5">
					<h3 class="text-lg font-semibold text-slate-900">Preview gallery</h3>
					<p class="mt-2 text-sm text-slate-600">
						Focused views of the experience—from immersive hero areas to structured detail sections.
					</p>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						{resolvedPreviewMain && (
							<div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
								<img src={resolvedPreviewMain} alt={`${title} homepage preview`} class="w-full object-cover" loading="lazy" decoding="async" />
							</div>
						)}
						{resolvedPreviewSecondary && (
							<div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
								<img
									src={resolvedPreviewSecondary}
									alt={`${title} interior page preview`}
									class="w-full object-cover"
									loading="lazy"
									decoding="async" />
							</div>
						)}
					</div>
				</div>
			</div>
		</section>

		<section id="whats-included" class="mx-auto max-w-6xl px-6 pb-12">
			<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm sm:px-10 sm:py-12">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">What's included</p>
						<h2 class="mt-2 text-2xl font-semibold text-slate-900">Everything you need to launch</h2>
						<p class="mt-2 max-w-2xl text-base text-slate-600">
							A comprehensive kit that keeps your build focused on storytelling. No extra libraries or
							client frameworks required.
						</p>
					</div>
					<div class="rounded-full bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-700">
						One-time license — lifetime value
					</div>
				</div>
				<ul class="mt-6 grid list-disc gap-3 pl-5 text-sm text-slate-700 md:grid-cols-2">
					{featureList.map((item) => (
						<li class="leading-relaxed">{item}</li>
					))}
				</ul>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 pb-12">
			<div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
				<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm">
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Technology</p>
					<h2 class="mt-2 text-2xl font-semibold text-slate-900">Modern stack, no bloat</h2>
					<p class="mt-2 text-base text-slate-600">
						Built with the latest stable releases. Optional carousel support available, but the page
						experiences are fully functional without additional scripts.
					</p>
					<div class="mt-4 grid gap-4 sm:grid-cols-2">
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
							<h3 class="text-lg font-semibold text-slate-900">Performance-first</h3>
							<p class="mt-1 text-sm text-slate-600">Lightweight pages with explicit sizing to avoid layout shift.</p>
						</div>
						<div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
							<h3 class="text-lg font-semibold text-slate-900">Accessible by design</h3>
							<p class="mt-1 text-sm text-slate-600">Semantic regions, focusable controls, and high-contrast text.</p>
						</div>
					</div>
				</div>
				<div class="rounded-3xl border border-slate-200 bg-white px-6 py-8 shadow-sm">
					<p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">FAQ</p>
					<h2 class="mt-2 text-2xl font-semibold text-slate-900">Frequently asked questions</h2>
					<dl class="mt-4 space-y-4 divide-y divide-slate-200">
						{faqs.map((item) => (
							<div class="pt-4 first:pt-0">
								<dt class="text-base font-semibold text-slate-900">{item.question}</dt>
								<dd class="mt-2 text-sm text-slate-600">{item.answer}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 pb-16">
			<div class="rounded-3xl border border-slate-200 bg-gradient-to-r from-slate-900 to-slate-800 px-6 py-10 text-white shadow-xl shadow-slate-900/10 sm:px-10">
				<div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
					<div class="space-y-3">
						<p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-200">Ready to ship</p>
						<h2 class="text-2xl font-semibold">Build a publication-grade studio site without extra JS.</h2>
						<p class="text-sm text-slate-200">
							Copy, paste, and launch. Tailwind utilities keep the design cohesive while letting you
							reshape sections in minutes.
						</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a
							href="/templates"
							class="rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-900 shadow-lg shadow-white/20 transition hover:-translate-y-0.5">
							Browse templates
						</a>
						<a
							href="#whats-included"
							class="rounded-full border border-white/40 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/70">
							Review deliverables
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	@media (prefers-reduced-motion: reduce) {
		* {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
